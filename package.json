{
  "name": "apple-community-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://klland.github.io/apple-community-dashboard",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "price:update:monthly": "node scripts/monthly-price-update.mjs",
    "price:update:monthly:dry": "node scripts/monthly-price-update.mjs --dry-run",
    "predeploy": "node node_modules/vite/bin/vite.js build && cp dist/index.html dist/404.html",
    "deploy": "node node_modules/gh-pages/bin/gh-pages.js -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.2",
    "@tailwindcss/vite": "^4.2.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
